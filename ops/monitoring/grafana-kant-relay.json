      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "expr": "sum(rate(kant_relay_reservation_errors_total{code=\"NO_RESERVATION\"}[5m])) * 60", "refId": "A" }],
      "title": "NO_RESERVATION / min",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "id": 5,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "expr": "increase(kant_relay_opk_burn_failures_total[15m])", "refId": "A" }],
      "title": "OPK burn failures / 15m",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 6,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "expr": "kant_relay_peers_active", "refId": "A" }],
      "title": "Connected peers",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "kant_relay_reservations_active", "legendFormat": "reservations", "refId": "A" },
        { "expr": "kant_relay_peers_active", "legendFormat": "peers", "refId": "B" },
        { "expr": "sum(kant_relay_registry_entries)", "legendFormat": "registry", "refId": "C" }
      ],
      "title": "Relay population",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }, "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 8,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum by (code) (rate(kant_relay_reservation_errors_total[5m])) * 60", "legendFormat": "{{code}}", "refId": "A" },
        { "expr": "sum by (reason) (rate(kant_relay_circuits_closed_total[5m])) * 60", "legendFormat": "circuit {{reason}}", "refId": "B" }
      ],
      "title": "Relay errors per minute",
      "type": "timeseries"
    }
