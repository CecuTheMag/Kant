{
  "name": "kant-monorepo",
  "version": "0.7.0",
  "private": true,
  "description": "Kant: private, end-to-end encrypted messenger with no one in the middle",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install:all": "pnpm install",
    "dev": "pnpm --dir packages/app dev",
    "build": "pnpm --dir packages/app build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "pnpm run typecheck",
    "test:lab": "pnpm --dir tests/lab test",
    "test:lab:ui": "pnpm --dir tests/lab test:ui",
    "test:lab:preflight": "bash tests/lab/scripts/preflight.sh",
    "test:reconnect": "pnpm --dir packages/relay run build && pnpm --dir packages/app run build && node --test --test-concurrency=1 --test-timeout=3600000 tests/lab/local/reconnect.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.7.4",
    "pnpm": "10.13.1",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "overrides": {
      "builder-util-runtime": "9.7.0",
      "fast-uri": "3.1.9",
      "ip-address": "10.7.6",
      "js-yaml": "4.3.2",
      "qs": "6.17.1",
      "hono": "4.13.18",
      "@hono/node-server": "2.1.7",
      "body-parser": "2.4.0"
    },
    "ignoredBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "workspaces": [
    "packages/*"
  ]
}
