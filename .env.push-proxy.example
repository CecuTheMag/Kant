# Settings for docker-compose.push-proxy.yml — the Android wake-up proxy.
#
#   cp .env.push-proxy.example .env.push-proxy
#   docker compose --env-file .env.push-proxy -f docker-compose.push-proxy.yml up -d --build
#
# Only an app built with your own Firebase project can use this (see
# packages/push-proxy/README.md). A relay needs neither Firebase nor this proxy
# to carry messages.

# Shared secret between the relay and the proxy. Use a long random value, for
# example: openssl rand -hex 32. Set the same value as PUSH_PROXY_SECRET on
# every relay that calls this proxy. The proxy refuses to start without it.
PUSH_PROXY_SECRET=

# Your Firebase project ID (Firebase console → Project settings).
FIREBASE_PROJECT_ID=

# The service-account JSON itself is not an environment variable: save it as
# .kant-secrets/firebase-service-account.json (that folder is git-ignored);
# the compose file mounts it read-only.

# Host port the proxy listens on (the container always uses 4001).
PUSH_PROXY_PORT=3002

# trace | debug | info | warn | error
LOG_LEVEL=info
