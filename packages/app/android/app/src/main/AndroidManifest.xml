<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No Android/Google backup: the database holds the identity and live
         double-ratchet sessions. A restored copy on a second device would fork
         every session (neither copy could then decrypt), and it would place the
         encrypted identity in a cloud account. Moving to a new phone must be an
         explicit Kant transfer instead. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Invite links: kant://add#k=<key>&n=<name> opens the Add contact sheet
                 (the kant.network/add page offers an "Open in Kant" button). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kant" android:host="add" />
            </intent-filter>

        </activity>

        <!-- FCM wake-up service (Signal-style: empty payload, no message content in FCM) -->
        <service
            android:name=".KantMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- KantMessagingService forwards events to Capacitor itself. Keep one
             FCM intent target so Android cannot select the plugin service instead. -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />

        <!-- Holds the process — and therefore the WebView's libp2p node — alive
             while the app is backgrounded, behind an ongoing notification with a
             Stop action. dataSync is the applicable foreground-service type:
             the work is maintaining a network connection for the user.
             stopWithTask mirrors onTaskRemoved: swiping the app away destroys
             the WebView, so the notification must not outlive it. -->
        <service
            android:name=".KantConnectionService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Package visibility (Android 11+): lets "Open with" tell whether any
         installed app can view a file, and lets links reach a browser or mail app. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Background relay connection. FOREGROUND_SERVICE_DATA_SYNC is required
         from Android 14 and must match the service's foregroundServiceType. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Scanning a friend's QR code to add them. Optional: devices without a
         camera can still paste an invite link. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Recording voice messages. Asked for the first time someone holds the
         mic button; MODIFY_AUDIO_SETTINGS lets the WebView apply echo
         cancellation and noise suppression to the capture. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
</manifest>
