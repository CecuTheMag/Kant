# Kant relay URL
# For local dev (auto-detected): leave empty or set to localhost
# VITE_RELAY_URL=http://127.0.0.1:3001
#
# For a public relay (non-localhost users MUST set this):
# VITE_RELAY_URL=https://relay.yourdomain.com
#
# Examples:
#   VITE_RELAY_URL=https://relay.yourdomain.com
#   VITE_RELAY_URL=http://192.168.0.100:3001
#   VITE_RELAY_URL=http://127.0.0.1:3001

# Legacy: specify just the HTTP port (used when VITE_RELAY_URL is not set)
# VITE_RELAY_HTTP_PORT=3001
